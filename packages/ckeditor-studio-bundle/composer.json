{
  "name": "chrastina/ckeditor-studio-bundle",
  "description": "CKEditor rich text editor integration for Pimcore Studio. Conference demo for Pimcore Community Dev Days 2026, modeled on pimcore/quill-bundle.",
  "license": "GPL-2.0-or-later",
  "type": "pimcore-bundle",
  "keywords": [
    "pimcore",
    "pimcore-studio",
    "ckeditor",
    "wysiwyg",
    "rich-text-editor"
  ],
  "homepage": "https://github.com/Simply007/pcdd26-pimcore-ai-guidepost",
  "authors": [
    {
      "name": "Ondrej Chrastina",
      "homepage": "https://ondrej.chrastina.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Simply007/pcdd26-pimcore-ai-guidepost/issues",
    "source": "https://github.com/Simply007/pcdd26-pimcore-ai-guidepost/tree/main/packages/ckeditor-studio-bundle"
  },
  "require": {
    "php": ">=8.3",
    "pimcore/pimcore": "^2026.1",
    "pimcore/studio-ui-bundle": "^2026.3"
  },
  "autoload": {
    "psr-4": {
      "Chrastina\\CKEditorStudioBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Chrastina\\CKEditorStudioBundle\\CKEditorStudioBundle"
      ]
    }
  }
}
