<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.getTitle() ?: 'Pimcore AI Guidepost' }}</title>
    <style>
        :root {
            --purple: #6428b4;
            --purple-dark: #3d1a70;
            --lime: #c9f24b;
            --ink: #241933;
            --muted: #6f6782;
            --paper: #faf9fc;
            --line: #e4def0;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 17px;
            line-height: 1.6;
            color: var(--ink);
            background: var(--paper);
        }

        header {
            background: linear-gradient(135deg, var(--purple-dark), var(--purple));
            color: #fff;
            padding: 56px 24px 48px;
        }

        header .inner, main, footer .inner {
            max-width: 900px;
            margin: 0 auto;
        }

        .eyebrow {
            display: inline-block;
            background: var(--lime);
            color: var(--purple-dark);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 999px;
            margin-bottom: 18px;
        }

        header h1 {
            margin: 0;
            font-size: 44px;
            line-height: 1.15;
            letter-spacing: -0.02em;
        }

        main {
            padding: 24px 24px 64px;
        }

        section {
            margin-top: 40px;
        }

        section h2 {
            font-size: 26px;
            letter-spacing: -0.01em;
            margin: 0 0 4px;
            color: var(--purple-dark);
        }

        section h2::after {
            content: "";
            display: block;
            width: 56px;
            height: 4px;
            margin-top: 8px;
            background: var(--lime);
            border-radius: 2px;
        }

        .wysiwyg p { margin: 14px 0; }

        .wysiwyg a {
            color: var(--purple);
            text-decoration-color: var(--lime);
            text-decoration-thickness: 2px;
            text-underline-offset: 3px;
        }

        .wysiwyg a:hover { color: var(--purple-dark); }

        .wysiwyg ul {
            padding-left: 24px;
            margin: 14px 0;
        }

        .wysiwyg li { margin: 6px 0; }

        .wysiwyg .code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.88em;
            background: #efeaf8;
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 1px 5px;
        }

        .wysiwyg table {
            width: 100%;
            border-collapse: collapse;
            margin: 18px 0;
            font-size: 15px;
            background: #fff;
            border: 1px solid var(--line);
        }

        .wysiwyg th {
            background: var(--purple-dark);
            color: #fff;
            text-align: left;
            padding: 10px 14px;
            font-weight: 600;
        }

        .wysiwyg td {
            padding: 10px 14px;
            border-top: 1px solid var(--line);
            vertical-align: top;
        }

        .wysiwyg tr:nth-child(even) td { background: #f5f1fb; }

        .lead { font-size: 19px; }

        footer {
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 14px;
            padding: 20px 24px 40px;
        }

        footer a { color: var(--purple); }
    </style>
</head>
<body>

<header>
    <div class="inner">
        <span class="eyebrow">Pimcore Community Dev Days 2026 &middot; Frankfurt &middot; 2026-11-10</span>
        <h1>{{ pimcore_input('headline', { width: 540 }) }}</h1>
    </div>
</header>

<main>
    <section class="wysiwyg lead">
        {{ pimcore_wysiwyg('intro', { height: 300 }) }}
    </section>

    <section>
        <h2>Found: Pimcore AI resources for coding agents</h2>
        <div class="wysiwyg">
            {{ pimcore_wysiwyg('found_resources', { height: 300 }) }}
        </div>
    </section>

    <section>
        <h2>Where to go next (as of 2026-11-08)</h2>
        <div class="wysiwyg">
            {{ pimcore_wysiwyg('marked_gaps', { height: 260 }) }}
        </div>
    </section>

    <section>
        <h2>The generated podcast (proof of discoverability)</h2>
        <div class="wysiwyg">
            {{ pimcore_wysiwyg('podcast_note', { height: 160 }) }}
        </div>
    </section>

    <section>
        <h2>Reference points from other ecosystems</h2>
        <div class="wysiwyg">
            {{ pimcore_wysiwyg('reference_points', { height: 200 }) }}
        </div>
    </section>
</main>

<footer>
    <div class="inner">
        This page is a Pimcore Document rendered from wysiwyg editables, seeded from the repo's
        <a href="https://github.com/Simply007/pcdd26-pimcore-ai-guidepost" target="_blank" rel="noopener">AGENTS.md</a>.
        Re-seed with <strong>bin/console app:guidepost:seed</strong>.
    </div>
</footer>

</body>
</html>
