<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.getTitle() ?: 'Landing page' }}</title>
    <style>
        :root {
            --purple: #6428b4;
            --purple-dark: #3d1a70;
            --lime: #c9f24b;
            --ink: #241933;
            --muted: #6f6782;
            --paper: #faf9fc;
            --line: #e4def0;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 17px;
            line-height: 1.6;
            color: var(--ink);
            background: var(--paper);
        }

        .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

        .hero {
            background: linear-gradient(135deg, var(--purple-dark), var(--purple));
            color: #fff;
            padding: 88px 0 72px;
        }

        .hero h1 { font-size: 48px; line-height: 1.1; margin: 0 0 16px; }
        .hero .subline { font-size: 21px; opacity: .9; max-width: 720px; }

        .features { padding: 64px 0; }
        .features .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
        .feature {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 24px;
        }
        .feature h2 { font-size: 21px; margin: 0 0 8px; color: var(--purple); }

        .cta {
            background: #fff;
            border-top: 1px solid var(--line);
            padding: 56px 0 72px;
            text-align: center;
        }
        .cta .button a {
            display: inline-block;
            margin-top: 16px;
            background: var(--lime);
            color: var(--ink);
            font-weight: 700;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 999px;
        }

        @media (max-width: 800px) {
            .hero h1 { font-size: 36px; }
        }
    </style>
</head>
<body>

<section class="hero">
    <div class="wrap">
        <h1>{{ pimcore_input('heroHeadline', { placeholder: 'Headline' }) }}</h1>
        <div class="subline">{{ pimcore_wysiwyg('heroSubline', { editorType: 'inline', placeholder: 'One or two sentences under the headline' }) }}</div>
    </div>
</section>

<section class="features">
    <div class="wrap grid">
        {% for i in 1..3 %}
            <div class="feature">
                <h2>{{ pimcore_input('featureTitle' ~ i, { placeholder: 'Feature ' ~ i }) }}</h2>
                {{ pimcore_wysiwyg('featureText' ~ i, { editorType: 'inline', placeholder: 'What this feature does for the reader' }) }}
            </div>
        {% endfor %}
    </div>
</section>

<section class="cta">
    <div class="wrap">
        {{ pimcore_wysiwyg('ctaText', { editorType: 'inline', placeholder: 'Closing message and call to action' }) }}
        <div class="button">{{ pimcore_link('ctaLink') }}</div>
    </div>
</section>

</body>
</html>
